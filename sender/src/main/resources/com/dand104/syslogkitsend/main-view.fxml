<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.dand104.syslogkitsend.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <GridPane hgap="10" vgap="10">
        <Label text="Host (IP):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="hostField" text="127.0.0.1" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS"/>

        <Label text="Port:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="portField" text="514" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Protocol:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="protocolBox" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <Label text="Syslog message (with tag &lt;PRIVAL&gt;):"/>
    <TextArea fx:id="messageArea" text="&lt;14&gt;Test syslog message" prefRowCount="5" wrapText="true"/>

    <Button text="Send" onAction="#onSendButtonClick" maxWidth="Infinity"/>

    <Label fx:id="statusLabel" text="Ready" textFill="gray" wrapText="true"/>
</VBox>